# Viral Video SaaS - Environment Variables

# Freepik API Key (optional - can be set via UI)
# Get your key at: https://www.freepik.com/api
FREEPIK_API_KEY=

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=production

# Storage paths (Docker will use /app/storage)
STORAGE_PATH=/app/storage

# Database path
DATABASE_PATH=/app/backend/database/viral_saas.db

# WebSocket settings
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# Rate limiting (requests per minute)
RATE_LIMIT_GENERATE=10
RATE_LIMIT_BATCH=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/viral-saas/app.log
